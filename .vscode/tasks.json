{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build All C++ Files",
            "type": "process",
            "command": "D:/C_code/mingw/mingw64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${fileDirname}/*.cpp",
                "-o",
                "${fileDirname}/program.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Compile all C++ source files in the current folder"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe 编译文件夹内所有 C++ 文件",
            "command": "D:\\C_code\\mingw\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${fileDirname}\\*.cpp",
                "-o",
                "${fileDirname}\\program.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "编译文件夹内所有 .cpp 文件并生成 program.exe"
        }
    ]
}